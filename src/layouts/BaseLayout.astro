---
import { Font } from "astro:assets";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import JsonLd from "@/components/JsonLd.astro";
import siteConfig from "@/data/site-config";
import type { BaseHeadProps, Thing, WithContext } from "@/data/types";
import { createWebPageSchema, createWebSiteSchema } from "@/utils/schema-utils";

import SmoothScroll from "../components/SmoothScroll.astro";

export type Props = BaseHeadProps & {
  lastModified?: Date;
  customSchemas?: WithContext<Thing>[];
  mainClass?: string;
};

const {
  lastModified,
  customSchemas = [],
  mainClass = "mx-auto w-full max-w-5xl py-12 sm:py-16 lg:py-20",
  ...head
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://pinux.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const schemas: WithContext<Thing>[] = [
  createWebSiteSchema(siteUrl),
  createWebPageSchema(
    canonicalUrl,
    head.title || siteConfig.title,
    head.description || siteConfig.description,
    lastModified,
  ),
];

if (customSchemas.length > 0) {
  schemas.push(...customSchemas);
}
---

<!doctype html>
<html lang="en" class="wrap-break-word antialiased">
  <head>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={`${Astro.site}rss.xml`}
    >

    <script is:inline>
    (() => {
      const stored = localStorage.getItem("theme");
      const theme =
        stored === "light" || stored === "dark"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      document.documentElement.classList.toggle("dark", theme === "dark");
    })();
    </script>
    <BaseHead {...head} />
    <Font cssVariable="--font-piersans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <JsonLd schema={schemas} />
  </head>
  <body>
    <SmoothScroll />

    <a
      href="#main"
      class="bg-primary text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 rounded-md px-4 py-2 text-sm font-medium"
    >
      Skip to content
    </a>
    <div
      class="flex min-h-screen flex-col min-h-0 overflow-hidden px-4 md:px-8"
    >
      <Header />
      <main id="main" class={mainClass}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
