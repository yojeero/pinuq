---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import JsonLd from "@/components/JsonLd.astro";
import siteConfig from "@/data/site-config";
import type { BaseHeadProps, Thing, WithContext } from "@/data/types";
import { createWebPageSchema, createWebSiteSchema } from "@/utils/schema-utils";

export type Props = BaseHeadProps & {
  lastModified?: Date;
  customSchemas?: WithContext<Thing>[];
  mainClass?: string;
  variant?: "landing" | "blog";
};

const {
  lastModified,
  customSchemas = [],
  mainClass,
  variant = "blog",
  ...head
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://pinuq.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const schemas: WithContext<Thing>[] = [
  createWebSiteSchema(siteUrl),
  createWebPageSchema(
    canonicalUrl,
    head.title || siteConfig.title,
    head.description || siteConfig.description,
    lastModified,
  ),
];

if (customSchemas.length > 0) {
  schemas.push(...customSchemas);
}
---

<!doctype html>
<html lang="en" class="wrap-break-word antialiased">
  <head>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={`${Astro.site}rss.xml`}
    >

    <script is:inline>
    function applyTheme() {
      const localStorageTheme = localStorage.getItem("theme");
      const systemSpeed = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      if (localStorageTheme === "dark" || (!localStorageTheme && systemSpeed)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    }

    applyTheme();

    document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <ClientRouter />

    <BaseHead {...head} />

    <Font cssVariable="--font-PierSans" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-playfair" preload />

    <JsonLd schema={schemas} />
  </head>

  <body>
    <a
      href="#main"
      class="text-foreground sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 rounded-md px-4 py-2 text-sm font-medium"
    >
      Skip to content
    </a>

    <main id="main" class="blog-grid">
      <slot />
    </main>
  </body>
</html>
