---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg">;

const { class: className, ...props } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...props}
>
  <circle cx="12" cy="12" r="10" />
  <path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72" />
  <path d="M3.34 7.5c6.83 0 13.72-.84 17.48-4.08" />
  <path
    d="M21.87 12.29c-2.91-.88-5.98-.83-8.89-.19-3.31.73-6.15 2.35-8.58 4.73"
  />
</svg>
