---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

import Badge from "@/components/Badge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Prose from "@/components/Prose.astro";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/utils/common-utils";
import { sortItemsByDateDesc } from "@/utils/data-utils";
import {
  createBlogPostingSchema,
  createPersonSchema,
} from "@/utils/schema-utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(sortItemsByDateDesc);

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newerPost: posts[index - 1] ?? null,
      olderPost: posts[index + 1] ?? null,
    },
  }));
}

type Props = {
  post: BlogPost;
  newerPost: BlogPost | null;
  olderPost: BlogPost | null;
};

const { post, newerPost, olderPost } = Astro.props;

const {
  title,
  publishDate,
  updatedDate,
  excerpt,
  tags = [],
  seo,
  coverImage,
  coverAlt,
} = post.data;

const ogImage = {
  src: new URL(`og/${post.id}.png`, Astro.site).toString(),
  alt: title,
};

const { Content, headings } = await render(post);

const postUrl = new URL(`/blog/${post.id}`, Astro.site).toString();

const authorSchema = createPersonSchema();
const blogPostingSchema = createBlogPostingSchema(post, postUrl, authorSchema);
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? excerpt}
  image={seo?.image ?? ogImage}
  pageType="article"
  lastModified={updatedDate ?? publishDate}
  publishedTime={publishDate}
  modifiedTime={updatedDate ?? publishDate}
  tags={tags}
  customSchemas={[blogPostingSchema]}
>
  <div>
    <h1 class="font-sans text-4xl font-semibold sm:text-[2.5rem]">{title}</h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
      <span class="text-foreground/60 text-sm">
        {updatedDate ? (
  <>
    Updated on <FormattedDate date={updatedDate} />
  </>
) : (
  <>
    Published on <FormattedDate date={publishDate} />
  </>
)}
      </span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {tags.length > 0 &&
  tags.map((tag) => <Badge href={`/tags/${slugify(tag)}/`}>{tag}</Badge>)}
      </div>
    </div>
  </div>

  <div class="mt-10">
    <article class="min-w-0 w-full max-w-3xl mx-auto">
      {coverImage && (
  <Image
    src={coverImage}
    alt={coverAlt ?? title}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 672px, 100vw"
    class="mb-10 aspect-video w-full rounded-sm object-cover"
  />
)}
      <div id="content">
        <Prose>
          <Content />
        </Prose>
      </div>
    </article>
  </div>

  {(olderPost || newerPost) && (
  <nav
    aria-label="Post navigation"
    class="mt-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
  >
    {olderPost ? (
      <a
        href={`/blog/${olderPost.id}/`}
        class="hover:text-foreground/80 text-foreground/60 transition-colors"
      >
        <span class="text-xs">&larr; Older post</span>
        <span class="block font-medium">{olderPost.data.title}</span>
      </a>
    ) : (
      <span class="hidden sm:block" aria-hidden="true" />
    )}
    {newerPost && (
      <a
        href={`/blog/${newerPost.id}/`}
        class="hover:text-foreground/80 text-foreground/60 transition-colors sm:text-right"
      >
        <span class="text-xs">Newer post &rarr;</span>
        <span class="block font-medium">{newerPost.data.title}</span>
      </a>
    )}
  </nav>
)}
</BaseLayout>
