---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Prose from "@/components/Prose.astro";
import siteConfig, { team } from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/utils/common-utils";
import { sortItemsByDateDesc } from "@/utils/data-utils";
import {
  createBlogPostingSchema,
  createPersonSchema,
} from "@/utils/schema-utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(sortItemsByDateDesc);

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newerPost: posts[index - 1] ?? null,
      olderPost: posts[index + 1] ?? null,
    },
  }));
}

type Props = {
  post: BlogPost;
  newerPost: BlogPost | null;
  olderPost: BlogPost | null;
};

const { post, newerPost, olderPost } = Astro.props;

const {
  title,
  publishDate,
  updatedDate,
  excerpt,
  tags = [],
  seo,
  coverImage,
  coverAlt,
  author,
} = post.data;

const authorName = author || siteConfig.author;
const matchedMember = team.find(
  (member) => member.author === authorName || member.name === authorName,
);
const authorAvatar = matchedMember
  ? matchedMember.avatar
  : siteConfig.image.src;

const ogImage = {
  src: new URL(`og/${post.id}.png`, Astro.site).toString(),
  alt: title,
};

const primaryTag = tags[0];

const { Content } = await render(post);

const postUrl = new URL(`/blog/${post.id}`, Astro.site).toString();

const authorSchema = createPersonSchema();
const blogPostingSchema = createBlogPostingSchema(post, postUrl, authorSchema);
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? excerpt}
  image={seo?.image ?? ogImage}
  pageType="article"
  lastModified={updatedDate ?? publishDate}
  publishedTime={publishDate}
  modifiedTime={updatedDate ?? publishDate}
  tags={tags}
  customSchemas={[blogPostingSchema]}
>
  <div class="max-w-3xl mx-auto w-full">
    <h1 class="font-medium leading-8 tracking-wide text-3xl lg:text-4xl">
      {title}
    </h1>
  </div>

  <div class="flex w-full max-w-3xl mx-auto items-center my-4">
    <div class="w-full flex items-center gap-4">
      {authorAvatar && (
  <Image
    src={authorAvatar}
    alt={authorName}
    class="h-12 w-12 rounded-full object-cover"
  />
)}
      <p class="text-slate-700 text-xs font-mono tracking-tighter">
        {authorName && <span class="pr-1">By {authorName}</span>}
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString("us-US", {
  day: "numeric",
  month: "numeric",
  year: "numeric",
})}
        </time>
      </p>
    </div>

    <div
      class="flex uppercase text-xs font-mono tracking-widest dark:bg-indigo-900/60 dark:text-stone-300 border-1 border-slate-600 px-1 rounded-xs"
    >
      {primaryTag && <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>}
    </div>
  </div>

  <div class="mt-10">
    <article class="min-w-0 w-full max-w-3xl mx-auto">
      {coverImage && (
  <Image
    src={coverImage}
    alt={coverAlt ?? title}
    widths={[520, 1040]}
    sizes="(min-width: 1024px) 672px, 100vw"
    class="mb-10 aspect-video w-full rounded-lg object-cover"
  />
)}
      <div id="content">
        <Prose>
          <Content />
        </Prose>
      </div>
    </article>
  </div>

  {(olderPost || newerPost) && (
  <nav
    aria-label="Post navigation"
    class="mt-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
  >
    {olderPost ? (
      <a
        href={`/blog/${olderPost.id}/`}
        class="hover:text-foreground/80 text-foreground/60 transition-colors"
      >
        <span class="text-xs">&larr; Older post</span>
        <span class="block font-medium">{olderPost.data.title}</span>
      </a>
    ) : (
      <span class="hidden sm:block" aria-hidden="true" />
    )}
    {newerPost && (
      <a
        href={`/blog/${newerPost.id}/`}
        class="hover:text-foreground/80 text-foreground/60 transition-colors sm:text-right"
      >
        <span class="text-xs">Newer post &rarr;</span>
        <span class="block font-medium">{newerPost.data.title}</span>
      </a>
    )}
  </nav>
)}
</BaseLayout>
