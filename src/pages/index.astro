---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugify } from "@/utils/common-utils";
import { sortItemsByDateDesc } from "@/utils/data-utils";

const allPosts = (await getCollection("blog")).sort(sortItemsByDateDesc);
const latestPosts = allPosts.slice(5, 14);
const categories = [
  ...new Set(allPosts.flatMap((post) => post.data.tags ?? [])),
].slice(0, 8);

const getExcerpt = (post: { data: { excerpt?: string } }) =>
  post?.data?.excerpt ??
  "Discover the latest Pinuq product updates, developer stories, and best practices.";
---

<BaseLayout
  title=""
  description="Digital product news and developer stories from Pinuq."
>
  <div role="presentation" class="top-bg-text" aria-hidden="true">TechBlog</div>

  <div
    class="mx-auto w-full max-w-5xl grid grid-cols-1 md:grid-cols-[3fr_1fr] gap-4 py-[clamp(4rem,6vw,8rem)] z-50"
  >
    <section class="flex flex-col max-w-2xl">
      <div class="flex items-center mb-6">
        <h1
          class="lg:text-6xl text-5xl leading-18 font-bold tracking-tight text-foreground dark:text-mist"
        >
          Tech Blog
        </h1>
      </div>

      <div class="grid gap-4 max-w-2xl mx-auto">
        {latestPosts.map((post) => (
  <article class="overflow-hidden py-12">
    <a href={`/blog/${post.id}/`} class="flex w-2/3 items-center">
      <h4 class="font-medium text-foreground hover:text-mist text-2xl tracking-wide">
        {post.data.title}
      </h4>
      <span class="px-4 text-[10px] uppercase items-end tracking-widest text-mauve-500 mt-1">
        {post.data.tags?.[0] ?? "Pinuq"}
      </span>
    </a>

    <p class=" mt-3 text-sm leading-6">{getExcerpt(post)}</p>

    <div class="mt-8 flex items-center gap-3 text-xs tracking-wide uppercase">
      {/* <span>{post.data.author || "Pinuq"}</span> */}
      <FormattedDate date={post.data.publishDate} format="short" />
    </div>
  </article>
))}
      </div>
    </section>

    <section class="p-2">
      <h3 class="font-medium text-sm tracking-wide p-6">Categories <Icon
    name="arrow-down-left"
    class="inline-flex h-6 w-6 outline-none p-1"
  /> 

      </h3>

      <div class="flex gap-4 flex-col p-6">
        {categories.map((tag) => (
  <a
    class="flex w-fit text-sm font-medium hover:text-mist text-foreground items-center"
    href={`/tags/${slugify(tag)}/`}
  >
   {tag}
   
  </a>
))}
      </div>
    </section>

    <a href="/blog/all">
      <button
        class="w-fit cursor-pointer grid place-items-center font-medium min-h-12 px-6 border-0 rounded-xl text-blue-50 text-xs tracking-widest bg-blue-500 hover:bg-blue-600 shadow-lg mt-12"
        type="button"
        aria-label="All articles"
        aria-pressed="false"
      >
        All articles
      </button>
    </a>
  </div>
</BaseLayout>
