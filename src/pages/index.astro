---
import { getCollection } from "astro:content";
import BentoHead from "@/components/BentoHead.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortItemsByDateDesc } from "@/utils/data-utils";

const allPosts = (await getCollection("blog")).sort(sortItemsByDateDesc);
const latestPosts = allPosts.slice(0, 14);

const getExcerpt = (post: { data: { excerpt?: string } }) =>
  post?.data?.excerpt ??
  "Discover the latest Pinuq product updates, developer stories, and best practices.";
---

<BaseLayout
  title=""
  description="Digital product news and developer stories from Pinuq."
>

<div
    class="mx-auto w-full max-w-5xl gap-4 py-[clamp(4rem,4vw,8rem)]"
  >

    <section class="flex flex-col gap-4">

      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-2 lg:gap-24">

       

        <div
          class="lg:text-9xl text-7xl font-bold leading-auto text-rose-500  text-center md:text-left">

          PINUQ

          <h1 class="text-2xl lg:text-3xl text-foreground dark:text-mist">            
            Talks about Digital, Apps and Linux.
          </h1>
      
        </div>      
        
        <BentoHead />

      </div>

      <div class="grid gap-4 p-4 max-w-2xl">
        {latestPosts.map((post) => (
  <article class="overflow-hidden py-12">
    <a href={`/blog/${post.id}/`} class="flex w-2/3 items-center">
      <h4 class="font-medium text-foreground hover:text-mist text-2xl tracking-wide">
        {post.data.title}
      </h4>
      <span class="px-4 text-[10px] uppercase items-end tracking-widest text-mauve-500 mt-1">
        {post.data.tags?.[0] ?? "Pinuq"}
      </span>
    </a>

    <p class=" mt-3 text-sm leading-6">{getExcerpt(post)}</p>

    <div class="mt-8 flex items-center gap-3 text-xs tracking-wide uppercase">
      <FormattedDate date={post.data.publishDate} format="short" />
    </div>
  </article>
))}
      </div>
    </section>

    <a href="/blog/all">
      <button
        class="w-fit cursor-pointer grid place-items-center font-medium min-h-12 px-6 border-0 rounded-xl text-blue-50 text-xs tracking-widest bg-blue-500 hover:bg-blue-600 shadow-lg mt-12 ml-4"
        type="button"
        aria-label="All articles"
        aria-pressed="false"
      >
        All articles
      </button>
    </a>
  </div>
</BaseLayout>
