---
import { getCollection } from "astro:content";
import BlogListing from "@/components/BlogListing.astro";
import { sortItemsByDateDesc } from "@/utils/data-utils";

const allPosts = (await getCollection("blog")).sort(sortItemsByDateDesc);
const posts = allPosts.slice(0, 20);
const categories = [
  ...new Set(allPosts.flatMap((post) => post.data.tags ?? [])),
];
---

<BlogListing posts={posts} categories={categories} currentPage={1} />
