---
import { getCollection } from "astro:content";
import About from "@/components/landing/About.astro";
import Blog from "@/components/landing/Blog.astro";
import Footer from "@/components/landing/Footer.astro";
import Hero from "@/components/landing/Hero.astro";
import Journal from "@/components/landing/Journal.astro";
import Team from "@/components/landing/Team.astro";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sortItemsByDateDesc } from "@/utils/data-utils";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/blog/**/*.{jpeg,jpg,png,webp,avif}",
);

const posts = (await getCollection("blog")).sort(sortItemsByDateDesc);

const blogPosts: { post: BlogPost; image: ImageMetadata }[] = [];
const usedIds = new Set<string>();
for (const post of posts) {
  if (blogPosts.length >= 2) break;
  const folder = post.id.split("/")[0];
  const prefix = `/src/content/blog/${folder}/`;
  const imageKeys = Object.keys(allImages)
    .filter((path) => path.startsWith(prefix))
    .sort();
  if (imageKeys.length > 0) {
    const imageModule = await allImages[imageKeys[0]]();
    blogPosts.push({ post, image: imageModule.default });
    usedIds.add(post.id);
  }
}
const journalPosts = posts.filter((p) => !usedIds.has(p.id)).slice(0, 3);
---

<BaseLayout
  title=""
  description="Software, mobile apps and the open source world. Engineering. Reviews. Tutorials."
  variant="landing"
>
  <Hero />
  <About />
  <Blog posts={blogPosts} />

  <div class="mx-auto grid grid-cols-1 items-center gap-4 md:grid-cols-2">
    <Team />
    <Journal posts={journalPosts} />
  </div>

  <Footer />
</BaseLayout>
