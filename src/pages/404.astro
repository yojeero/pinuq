---
import siteConfig from "@/data/site-config";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description={siteConfig.description}
  image={siteConfig.image}
  noindex
>
  <section>
    <h1 class="font-bold text-4xl sm:text-[2.5rem]">
      Page Not Found
    </h1>
    <p class="mt-5 mb-6 text-base leading-relaxed sm:text-lg">
      The page you are looking for does not exist. It may have been moved, or
      the URL might be mistyped.
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="/"
        class="text-foreground text-sm "
      >
        Go to Homepage
      </a>
    </div>
  </section>
</BaseLayout>
