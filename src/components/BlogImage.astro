---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  zoom?: number;
  position?:
    | "center"
    | "top"
    | "bottom"
    | "left"
    | "right"
    | "top-left"
    | "top-right"
    | "bottom-left"
    | "bottom-right";
}

const { src, alt, zoom = 100, position = "center" } = Astro.props;

const originMap: Record<NonNullable<Props["position"]>, string> = {
  center: "center center",
  top: "top center",
  bottom: "bottom center",
  left: "center left",
  right: "center right",
  "top-left": "top left",
  "top-right": "top right",
  "bottom-left": "bottom left",
  "bottom-right": "bottom right",
};

const imageStyle = {
  transform: `scale(${zoom / 100})`,
  "transform-origin": originMap[position],
};
---

<div
  class="h-96 aspect-[4/3] overflow-hidden my-6 select-none pointer-events-none"
>
  <Image
    src={src}
    alt={alt}
    class="w-full h-full object-cover"
    style={imageStyle}
  />
</div>
