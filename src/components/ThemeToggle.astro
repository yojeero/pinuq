---
// src/components/toggle.astro
---

<div class="theme-toggle-wrapper">
  <input
    id="toggle-on"
    class="toggle toggle-left"
    name="theme-radio"
    value="light"
    type="radio"
    checked
  >
  <label for="toggle-on" class="color-btn">light</label>

  <input
    id="toggle-off"
    class="toggle toggle-right"
    name="theme-radio"
    value="dark"
    type="radio"
  >
  <label for="toggle-off" class="color-btn">dark</label>
</div>

<script>
const THEME_STORAGE_KEY = "theme";
const THEME_COLORS = { light: "#f0ece3", dark: "#1c2644" } as const;

const getThemeState = () => document.documentElement.classList.contains("dark");

function syncThemeElements() {
  const isDark = getThemeState();

  const radioLight = document.getElementById(
    "toggle-on",
  ) as HTMLInputElement | null;
  const radioDark = document.getElementById(
    "toggle-off",
  ) as HTMLInputElement | null;

  if (radioLight && radioDark) {
    radioLight.checked = !isDark;
    radioDark.checked = isDark;
  }

  const color = isDark ? THEME_COLORS.dark : THEME_COLORS.light;
  for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
    meta.setAttribute("content", color);
  }
}

function setupTheme() {
  syncThemeElements();

  const radioLight = document.getElementById("toggle-on");
  const radioDark = document.getElementById("toggle-off");

  if (radioLight && radioDark) {
    radioLight.removeEventListener("change", handleThemeChange);
    radioDark.removeEventListener("change", handleThemeChange);

    radioLight.addEventListener("change", handleThemeChange);
    radioDark.addEventListener("change", handleThemeChange);
  }
}

function handleThemeChange(e: Event) {
  const target = e.target as HTMLInputElement;
  const newTheme = target.value; // 'light' или 'dark'

  document.documentElement.classList.toggle("dark", newTheme === "dark");
  localStorage.setItem(THEME_STORAGE_KEY, newTheme);
  syncThemeElements();
}

document.addEventListener("astro:page-load", setupTheme);

window
  .matchMedia("(prefers-color-scheme: dark)")
  .addEventListener("change", (e) => {
    if (localStorage.getItem(THEME_STORAGE_KEY)) return;
    document.documentElement.classList.toggle("dark", e.matches);
    syncThemeElements();
  });
</script>
