---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle Theme"
  aria-pressed="false"
>
  <svg
    class="h-8 w-8 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <svg
    class="hidden h-8 w-8 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
</button>

<script>
const THEME_STORAGE_KEY = "theme";
const darkScheme = window.matchMedia("(prefers-color-scheme: dark)");
// Persisted on globalThis so the router events below can reach it after the
// Astro-scoped module has finished executing.
Object.assign(globalThis, { darkScheme });
const THEME_COLORS = { light: "#f0ece3", dark: "#1c2644" } as const;
const root = document.documentElement;

function getStoredTheme(): "light" | "dark" | null {
  const stored = localStorage.getItem(THEME_STORAGE_KEY);
  return stored === "light" || stored === "dark" ? stored : null;
}

function isDark(): boolean {
  return root.classList.contains("dark");
}

function syncThemeColor() {
  const color = isDark() ? THEME_COLORS.dark : THEME_COLORS.light;
  for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
    meta.setAttribute("content", color);
  }
}

function syncToggleButton() {
  const button = document.getElementById("theme-toggle");
  if (button) {
    button.setAttribute("aria-pressed", String(isDark()));
  }
}

const initTheme = () => {
  const button = document.getElementById("theme-toggle");
  if (!button || button.dataset.themeBound === "true") return;

  const onClick = () => {
    const theme = isDark() ? "light" : "dark";
    root.classList.toggle("dark", theme === "dark");
    localStorage.setItem(THEME_STORAGE_KEY, theme);
    syncToggleButton();
    syncThemeColor();
  };

  button.addEventListener("click", onClick);
  button.dataset.themeBound = "true";
  syncToggleButton();
  syncThemeColor();
};

const applyStoredTheme = () => {
  const stored = getStoredTheme();
  root.classList.toggle(
    "dark",
    stored ? stored === "dark" : darkScheme.matches,
  );
  syncToggleButton();
  syncThemeColor();
};

// Astro scopes inline <script> blocks, so nothing here is global unless the
// module explicitly opts in. Pages/router events and the reduced-motion media
// query listener cross that boundary and need globalThis.
initTheme();

globalThis.addEventListener("astro:page-load", initTheme);
globalThis.addEventListener("astro:after-swap", applyStoredTheme);

darkScheme.addEventListener("change", () => {
  if (getStoredTheme()) return;
  root.classList.toggle("dark", darkScheme.matches);
  syncToggleButton();
  syncThemeColor();
});
</script>
