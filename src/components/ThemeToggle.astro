---
import { CircleArrowRightUp } from "reicon-astro";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle Theme"
  aria-pressed="false"
  class="inline-flex items-center cursor-pointer"
>
  <span class="text-foreground hover:text-rose-500 text-xs mb-4 uppercase"
    >Switch Theme

    <CircleArrowRightUp
      class="h-6 aspect-square ml-2 mb-1 inline-flex transition-colors text-blue-400"
    />
  </span>
</button>

<script>
const THEME_STORAGE_KEY = "theme";
const darkScheme = window.matchMedia("(prefers-color-scheme: dark)");
Object.assign(globalThis, { darkScheme });
const THEME_COLORS = { light: "#f0ece3", dark: "#1c2644" } as const;
const root = document.documentElement;
function isDark() {
  return document.documentElement.classList.contains("dark");
}

function getStoredTheme(): "light" | "dark" | null {
  const stored = localStorage.getItem(THEME_STORAGE_KEY);
  return stored === "light" || stored === "dark" ? stored : null;
}

function syncThemeColor() {
  const color = isDark() ? THEME_COLORS.dark : THEME_COLORS.light;
  for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
    meta.setAttribute("content", color);
  }
}

function syncToggleButton() {
  const button = document.getElementById("theme-toggle");
  if (button) {
    button.setAttribute("aria-pressed", String(isDark()));
  }
}

const initTheme = () => {
  syncToggleButton();
  syncThemeColor();
};

const onClick = (event: Event) => {
  const target = event.target as HTMLElement | null;
  if (!target?.closest("#theme-toggle")) return;
  const theme = isDark() ? "light" : "dark";
  root.classList.toggle("dark", theme === "dark");
  localStorage.setItem(THEME_STORAGE_KEY, theme);
  syncToggleButton();
  syncThemeColor();
};

document.addEventListener("click", onClick);

const applyStoredTheme = () => {
  const stored = getStoredTheme();
  root.classList.toggle(
    "dark",
    stored ? stored === "dark" : darkScheme.matches,
  );
  syncToggleButton();
  syncThemeColor();
};

initTheme();

globalThis.addEventListener("astro:page-load", initTheme);
globalThis.addEventListener("astro:after-swap", applyStoredTheme);

darkScheme.addEventListener("change", () => {
  if (getStoredTheme()) return;
  root.classList.toggle("dark", darkScheme.matches);
  syncToggleButton();
  syncThemeColor();
});
</script>
