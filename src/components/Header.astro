---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];
---

<header class="w-full backdrop-blur-sm py-4 z-10">
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <div class="flex">
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="flex items-center gap-3 text-lg font-medium tracking-tight  text-foreground dark:text-mist hover:text-mauve"
          aria-label={siteConfig.title}
        >
          <Icon
            name="note"
            class="h-5 w-5 items-center text-foreground hover:text-mauve"
          />

          <span>Pinuq</span>
        </a>
      </div>

      <nav
        class="hidden items-center gap-8 text-sm md:flex gap-6 ml-12"
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
  <a href={item.href} class="tracking-wider text-foreground hover:text-mauve">
    {item.text}
  </a>
))}
      </nav>
    </div>

    <div class="inline-flex gap-x-2">
      <ThemeToggle />
      <a href="/rss.xml"
        ><Icon
          name="rss"
          class="h-5 w-5 text-foreground dark:text-blue-600 hover:text-mauve outline-none"
        /></a
      >
    </div>
  </div>
</header>
