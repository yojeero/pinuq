---
import { Icon } from "astro-icon/components";
import { CloseSquare, Menu } from "reicon-astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="w-full py-24 lg:border-b border-line">
  <div
    class="relative mx-auto flex items-center justify-between flex-wrap max-w-7xl w-full z-20 py-4 px-8"
  >
    <a href="/" class="flex flex-no-shrink" aria-label={siteConfig.title}>
      <Icon
        name="pinuq"
        class="h-8 w-auto text-black hover:text-rose-600 dark:text-rose-500"
      />
    </a>

    <div class="flex">
      <button
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle="open"
      >
        <Menu
          class="w-6 h-6 text-foreground transition-colors hover:text-rose-500"
        />
      </button>

      <div id="site-nav" class="nav-links">
        <button
          type="button"
          aria-label="Close navigation menu"
          class="burger-close"
          data-nav-toggle="close"
        >
          <CloseSquare
            class="w-6 h-6 text-foreground transition-colors hover:text-rose-500"
          />
        </button>

        <div id="nav-content" class="grid grid-rows-2">
          <nav aria-label="Primary" class="flex flex-col items-center gap-4">
            {navItems.map((item) => (
  <a
    href={item.href}
    aria-current={isActive(item.href) ? "page" : undefined}
    class="flex text-4xl leading-12 tracking-wider text-foreground hover:text-slate-600 hover:dark:text-indigo-500"
  >
    {item.text}
  </a>
))}
          </nav>

          <div
            class="grid w-fit h-fit p-4 bg-rose-500 rounded-full text-white hover:bg-blue-800 self-center mx-auto mt-12"
          >
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
const getNav = () => document.getElementById("site-nav");
const getToggles = () =>
  Array.from(document.querySelectorAll<HTMLElement>("[data-nav-toggle]"));

const setOpen = (open: boolean) => {
  const nav = getNav();
  if (!nav) return;
  nav.classList.toggle("is-open", open);
  document.documentElement.classList.toggle("nav-open", open);
  getToggles().forEach((toggle) => {
    toggle.setAttribute("aria-expanded", String(open));
  });
};

const isOpen = () => getNav()?.classList.contains("is-open") ?? false;

document.addEventListener("click", (event) => {
  const toggle = (event.target as HTMLElement | null)?.closest<HTMLElement>(
    "[data-nav-toggle]",
  );
  if (toggle) {
    setOpen(toggle.dataset.navToggle === "open");
    return;
  }
  if (isOpen()) {
    const nav = getNav();
    if (nav && !nav.contains(event.target as Node)) setOpen(false);
  }
});

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") setOpen(false);
});

// close the menu when a nav link is clicked (event delegation survives swaps)
document.addEventListener("click", (event) => {
  const nav = getNav();
  if (!nav?.classList.contains("is-open")) return;
  const link = (event.target as HTMLElement | null)?.closest("a");
  if (link && nav.contains(link)) setOpen(false);
});

// ensure the menu starts closed on every navigation (full load or swap)
document.addEventListener("astro:before-preparation", () => setOpen(false));
document.addEventListener("astro:page-load", () => setOpen(false));
</script>

<style>
:global(html.nav-open),
:global(html.nav-open body) {
  overflow: hidden;
}
</style>
