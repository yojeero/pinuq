---
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";
---

<header class="flex min-h-24 items-center">
  <div
    class="relative mx-auto flex items-center justify-between flex-wrap p-6 max-w-7xl w-full z-20 lg:px-0"
  >
    <div class="flex flex-no-shrink items-center pr-2 pt-2 w-full">
      <a class="flex" aria-label={siteConfig.title} href="/">
        <img
          src={siteConfig.logo.src}
          alt={siteConfig.logo.alt}
          class="h-16 w-16 rounded-full bg-slate-50 hover:-rotate-12 transition-transform duration-500 shrink-0"
        >
      </a>
      <div
        class="flex flex-row flex-1 font-mono uppercase text-[0.7rem] tracking-wide items-center gap-2 py-1 ml-6"
      >
        <span
          class="flex items-center w-1.5 h-1.5 rounded-full bg-green-600"
          aria-hidden="true"
        ></span>

        PINUX
      </div>

      <button
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-nav"
        class="burger"
        data-nav-toggle="open"
      >
        <span class="burger__bar"></span>
        <span class="burger__bar"></span>
        <span class="burger__bar"></span>
      </button>

      <div id="site-nav" class="nav-links">
        <button
          type="button"
          aria-label="Close navigation menu"
          class="burger burger--close"
          data-nav-toggle="close"
        >
          <span class="burger__bar"></span>
          <span class="burger__bar"></span>
        </button>

        <div id="nav-content">
          <ul class="nav">
            <li class="nav-top"><span>PINUX</span> <ThemeToggle /></li>

            <li><a href="/">Home</a></li>
            <li>
              <a class="nav-link" href="/about" rel="prefetch">About</a>
            </li>
            <li><a href="/about">Tags</a></li>
            <li><a href="/about">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
const initNav = () => {
  const nav = document.getElementById("site-nav");
  if (!nav || nav.dataset.navReady === "true") return;

  const toggles = Array.from(
    document.querySelectorAll<HTMLElement>("[data-nav-toggle]"),
  );
  if (toggles.length === 0) return;
  nav.dataset.navReady = "true";

  const setOpen = (open: boolean) => {
    nav.classList.toggle("is-open", open);
    document.documentElement.classList.toggle("nav-open", open);
    for (const toggle of toggles) {
      toggle.setAttribute("aria-expanded", String(open));
    }
  };

  for (const toggle of toggles) {
    toggle.addEventListener("click", () => {
      setOpen(toggle.dataset.navToggle === "open");
    });
  }

  nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (nav.contains(target) || toggles.some((t) => t.contains(target))) return;
    setOpen(false);
  });
};

initNav();
document.addEventListener("astro:page-load", initNav);
</script>

<style>
:global(html.nav-open),
:global(html.nav-open body) {
  overflow: hidden;
}
</style>
