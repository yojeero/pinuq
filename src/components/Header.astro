---
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";
---

<header class="flex min-h-24 items-center">
  <div
    class="relative mx-auto flex items-center justify-between flex-wrap p-6 max-w-6xl w-full z-20 lg:px-0"
  >
    <a class="flex flex-no-shrink" aria-label={siteConfig.title} href="/">
      <img
        src={siteConfig.logo.src}
        alt={siteConfig.logo.alt}
        class="h-16 w-16 rounded-full bg-stone-50 hover:-rotate-12 transition-transform duration-500 shrink-0 dark:bg-amber-300"
      >
    </a>

    <div class="flex">
      <button
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="site-nav"
        class="burger"
        data-nav-toggle="open"
      >
        <span class="burger__bar w-6 self-end"></span>
        <span class="burger__bar w-8 self-center"></span>
        <span class="burger__bar w-5 self-start"></span>
      </button>

      <div id="site-nav" class="nav-links">
        <button
          type="button"
          aria-label="Close navigation menu"
          class="burger burger--close"
          data-nav-toggle="close"
        >
          <span class="burger__bar w-8"></span>
          <span class="burger__bar w-8"></span>
        </button>

        <div id="nav-content" class="grid grid-rows-2">
          <ul
            class="flex flex-col items-center gap-4 m-0 p-0 list-none text-4xl leading-12 tracking-wider mt-12 text-black dark:text-indigo-300/40"
          >
            <li class="hover:text-slate-600 hover:dark:text-indigo-500">
              <a href="/">Home</a>
            </li>
            <li class="hover:text-slate-600 hover:dark:text-indigo-500">
              <a href="/about">About</a>
            </li>
            <li class="hover:text-slate-600 hover:dark:text-indigo-500">
              <a href="/about">Tags</a>
            </li>
            <li class="hover:text-slate-600 hover:dark:text-indigo-500">
              <a href="/about">Contact</a>
            </li>
          </ul>

          <div
            class="grid w-fit h-fit p-4 bg-indigo-500/40 rounded-full text-white hover:bg-blue-800 self-center mx-auto"
          >
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
const initNav = () => {
  const nav = document.getElementById("site-nav");
  if (!nav || nav.dataset.navReady === "true") return;

  const toggles = Array.from(
    document.querySelectorAll<HTMLElement>("[data-nav-toggle]"),
  );
  if (toggles.length === 0) return;

  const setOpen = (open: boolean) => {
    nav.classList.toggle("is-open", open);
    document.documentElement.classList.toggle("nav-open", open);
    toggles.forEach((toggle) => {
      toggle.setAttribute("aria-expanded", String(open));
    });
  };

  const onToggleClick = (event: Event) => {
    const toggle = event.currentTarget as HTMLElement;
    setOpen(toggle.dataset.navToggle === "open");
  };

  const onKeydown = (event: KeyboardEvent) => {
    if (event.key === "Escape") setOpen(false);
  };

  const onDocumentClick = (event: MouseEvent) => {
    const target = event.target as Node;
    if (nav.contains(target) || toggles.some((t) => t.contains(target))) return;
    setOpen(false);
  };

  toggles.forEach((toggle) => {
    toggle.addEventListener("click", onToggleClick);
  });

  nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", onKeydown);
  document.addEventListener("click", onDocumentClick);

  nav.dataset.navReady = "true";
};

const cleanupNav = () => {
  const nav = document.getElementById("site-nav");
  if (!nav) return;
  nav.dataset.navReady = "false";
  nav.classList.remove("is-open");
  document.documentElement.classList.remove("nav-open");
};

initNav();
document.addEventListener("astro:page-load", initNav);
document.addEventListener("astro:before-preparation", cleanupNav);
</script>

<style>
:global(html.nav-open),
:global(html.nav-open body) {
  overflow: hidden;
}
</style>
