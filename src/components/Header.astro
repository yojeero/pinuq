---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="w-full py-24">
  <div
    class="relative z-20 mx-auto flex w-full max-w-7xl items-center justify-between py-4 tracking-wider"
  >
    <a
      href="/"  
      aria-label={siteConfig.title} 
      class="main-logo"
    >

      <Icon
        name="cup"
        class="h-10 w-10 inline-flex text-white mr-2 bg-white/20 rounded-full flex-shrink-0 p-2"
      />

      <span>{siteConfig.title}</span>
    </a>

    <button
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle="open"
      class="inline-flex text-xs uppercase text-foreground items-center"
    >
      Menu

      <Icon
        name="menu2"
        class="h-8 w-8 text-foreground hover:text-mauve-500 ml-2"
      />
    </button>

    <div id="site-nav" class="nav-links">
      <button
        type="button"
        aria-label="Close navigation menu"
        class="burger-close"
        data-nav-toggle="close"
      >
        <Icon
          name="close"
          class="h-8 w-8 text-foreground hover:text-mauve-500"
        />
      </button>

      <div
        id="nav-content"
        class="fixed inset-0 z-20 flex h-full w-full flex-col items-start justify-between p-18"
      >
        <a
          href="/"
          class="text-2xl hover:text-mauve tracking-wider"
          aria-label={siteConfig.title}
        >
          {siteConfig.title}
        </a>

        <nav aria-label="Primary" class="flex w-full flex-col gap-4">
          {navItems.map((item, index) => {
  const num = String(index + 1).padStart(2, "0");

  return (
    <a
      href={item.href}
      aria-current={isActive(item.href) ? "page" : undefined}
      class="inline-flex items-baseline border-b border-line pb-8 text-4xl md:text-6xl lg:text-8xl tracking-wider text-foreground hover:text-mauve dark:hover:text-indigo-500"
    >
      {item.text}

      <span class="ml-4 text-base self-end text-stone-600/60">{num}</span>
    </a>
  );
})}
        </nav>

        <div class="flex w-full justify-between gap-2">

          <ThemeToggle />

          <div class="flex flex-col gap-1">

          <div class="flex text-sm gap-3">
            <a class="hover:text-mauve" href="https://instagram.com">
              Instagram 
            </a>
            <a class="hover:text-mauve" href="https://github.com/yojeero">
              Github 
            </a>
            <a class="hover:text-mauve" href="https://dribbble.com/yojeero"> Dribbble
            </a>
          </div>

          <div class="text-sm smallcase text-mauve hover:text-mauve-700 cursor-pointer">
            hello @
            <a href="https://pinuq.vercel.app">pinuq</a>
          </div>

          </div>

        </div>
      </div>
    </div>
  </div>
</header>

<script>
const getElement = <T extends HTMLElement>(selector: string) =>
  document.querySelector<T>(selector);

const isOpen = () =>
  getElement("#site-nav")?.classList.contains("is-open") ?? false;

const setOpen = (open: boolean) => {
  const nav = getElement("#site-nav");
  if (!nav) return;

  nav.classList.toggle("is-open", open);
  document.documentElement.classList.toggle("nav-open", open);

  document
    .querySelectorAll<HTMLElement>("[data-nav-toggle]")
    .forEach((toggle) => {
      toggle.setAttribute("aria-expanded", String(open));
    });
};

const handleDocumentClick = (event: MouseEvent) => {
  const target = event.target instanceof Element ? event.target : null;

  const toggle = target?.closest<HTMLElement>("[data-nav-toggle]");
  if (toggle) {
    setOpen(toggle.dataset.navToggle === "open");
    return;
  }

  if (!isOpen()) return;

  const nav = getElement("#site-nav");
  if (nav && target && nav.contains(target)) {
    if (target.closest("a")) setOpen(false);
    return;
  }

  if (nav) setOpen(false);
};

const handleDocumentKeydown = (event: KeyboardEvent) => {
  if (event.key === "Escape") setOpen(false);
};

document.addEventListener("click", handleDocumentClick);
document.addEventListener("keydown", handleDocumentKeydown);
document.addEventListener("astro:before-preparation", () => setOpen(false));
document.addEventListener("astro:page-load", () => setOpen(false));
</script>

<style>
:global(html.nav-open),
:global(html.nav-open body) {
  overflow: hidden;
}
</style>
