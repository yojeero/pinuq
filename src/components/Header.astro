---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="w-full border-b-1 border-b-mauve">
  <div
    class="relative z-20 mx-auto flex w-full max-w-6xl items-center justify-between py-4 tracking-wider font-bold"
  >
    <a href="/" aria-label={siteConfig.title}>
      <div
        class="skew-logo bg-accent inline-flex px-3 py-1 flex items-center  rounded-br-4xl rounded-tl-4xl transform skew-x-[-20deg]"
      >
        <Icon
          name="cup"
          class="h-10 w-10 inline-flex text-white mr-2 flex-shrink-0 p-2  transform skew-x-[20deg]"
        />
      </div>
    </a>

    <button
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle="open"
      class="inline-flex font-sans-light text-xs uppercase text-mauve items-center hover:text-black"
    >
      Menu

      <Icon
        name="menu"
        class="h-8 w-8 text-foreground hover:text-mauve-500 ml-2"
      />
    </button>

    <div id="site-nav" class="nav-links">
      <button
        type="button"
        aria-label="Close navigation menu"
        class="absolute z-50 right-8 top-8"
        data-nav-toggle="close"
      >
        <Icon
          name="close"
          class="h-8 w-8 text-foreground hover:text-mauve-500"
        />
      </button>

      <div
        id="nav-content"
        class="fixed inset-0 z-20 flex h-full w-full flex-col items-start justify-between p-8 lg:p-18"
      >
        <a
          href="/"
          class="text-lg hover:text-mauve tracking-wider"
          aria-label={siteConfig.title}
        >
          {siteConfig.title}
        </a>

        <nav aria-label="Primary" class="flex w-full flex-col gap-4">
          {navItems.map((item, index) => {
  const num = String(index + 1).padStart(2, "0");

  return (
    <a
      href={item.href}
      aria-current={isActive(item.href) ? "page" : undefined}
      class="inline-flex items-baseline border-b border-line pb-8 text-6xl lg:text-8xl tracking-wider text-foreground hover:text-mauve"
    >
      {item.text}

      <span class="ml-4 text-base self-end text-stone-600/60">{num}</span>
    </a>
  );
})}
        </nav>

        <div class="flex w-full justify-between gap-2">
          <ThemeToggle />

          <div class="flex flex-col">
            <div class="flex text-sm  gap-3">
              <a class="hover:text-mauve" href="https://instagram.com">
                Instagram
              </a>
              <a class="hover:text-mauve" href="https://github.com/yojeero">
                Github
              </a>
            </div>

            <div
              class="text-sm smallcase text-mauve hover:text-mauve-700 cursor-pointer"
            >
              hello @
              <a href="https://pinuq.vercel.app">pinuq</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
const getElement = <T extends HTMLElement>(selector: string) =>
  document.querySelector<T>(selector);

const isOpen = () =>
  getElement("#site-nav")?.classList.contains("is-open") ?? false;

const setOpen = (open: boolean) => {
  const nav = getElement("#site-nav");
  if (!nav) return;

  nav.classList.toggle("is-open", open);
  document.documentElement.classList.toggle("nav-open", open);

  document
    .querySelectorAll<HTMLElement>("[data-nav-toggle]")
    .forEach((toggle) => {
      toggle.setAttribute("aria-expanded", String(open));
    });
};

const handleDocumentClick = (event: MouseEvent) => {
  const target = event.target instanceof Element ? event.target : null;

  const toggle = target?.closest<HTMLElement>("[data-nav-toggle]");
  if (toggle) {
    setOpen(toggle.dataset.navToggle === "open");
    return;
  }

  if (!isOpen()) return;

  const nav = getElement("#site-nav");
  if (nav && target && nav.contains(target)) {
    if (target.closest("a")) setOpen(false);
    return;
  }

  if (nav) setOpen(false);
};

const handleDocumentKeydown = (event: KeyboardEvent) => {
  if (event.key === "Escape") setOpen(false);
};

document.addEventListener("click", handleDocumentClick);
document.addEventListener("keydown", handleDocumentKeydown);
document.addEventListener("astro:before-preparation", () => setOpen(false));
document.addEventListener("astro:page-load", () => setOpen(false));
</script>

<style>
:global(html.nav-open),
:global(html.nav-open body) {
  overflow: hidden;
}
</style>
