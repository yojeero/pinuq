---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

// const navItems = [
//   { text: "Blog", href: "/blog/all" },
//   { text: "About", href: "/about" },
//   { text: "Team", href: "/team" },
// ];

const navItems = [
  { text: "Blog", href: "/blog/all", icon: "blog" }, 
  { text: "About", href: "/about", icon: "info" },
  { text: "Team", href: "/team", icon: "users" },
  { text: "RSS", href: "/rss.xml", icon: "rss" },
];
---

<header class="flex w-full mx-auto max-w-7xl items-center justify-between  backdrop-blur-sm py-6 z-30">

    <div class="flex w-full items-center">
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="flex items-center gap-3 text-lg font-medium tracking-tight  text-foreground dark:text-green hover:text-mauve dark:hover:text-rose-500 rounded-full bg-rose-500 p-3"
          aria-label={siteConfig.title}
        >
          <Icon
            name="note"
            class="h-5 w-5 items-center text-white hover:text-rose-50" 
          /> 

          <!-- <span>Pinuq</span> -->
        </a>
      </div>

      <nav
        class="hidden items-center mx-auto text-sm md:flex gap-6"
  
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
  <a
    href={item.href}
    class="tracking-wider text-foreground hover:text-mauve dark:hover:text-green"
  >
    <span class="text-foreground/50"> / </span> {item.icon && <Icon name={item.icon} class="h-4 w-4 inline-flex mx-2 text-blue-500" />} 
             <span>{item.text}</span>
  </a> 

))}  
      </nav>
    </div>

      <ThemeToggle />

</header>
