---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

// const navItems = [
//   { text: "Blog", href: "/blog/all" },
//   { text: "About", href: "/about" },
//   { text: "Team", href: "/team" },
// ];

const navItems = [
  { text: "Blog", href: "/blog/all", icon: "blog" }, 
  { text: "About", href: "/about", icon: "info" },
  { text: "Team", href: "/team", icon: "users" },
];
---

<header class="w-full backdrop-blur-sm py-4 z-30">
  <div
    class="flex w-full max-w-7xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <div class="flex w-full items-center justify-between md:justify-evenly mx-auto">
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="flex items-center gap-3 text-lg font-medium tracking-tight  text-foreground dark:text-green hover:text-mauve dark:hover:text-rose-500 rounded-full bg-rose-500 p-3"
          aria-label={siteConfig.title}
        >
          <Icon
            name="note"
            class="h-5 w-5 items-center text-white hover:text-rose-50" 
          /> 

          <!-- <span>Pinuq</span> -->
        </a>
      </div>

      <nav
        class="hidden items-center justify-center text-sm md:flex gap-6"
  
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
  <a
    href={item.href}
    class="tracking-wider text-foreground hover:text-mauve dark:hover:text-green"
  >
    <span class="text-foreground/50"> / </span> {item.icon && <Icon name={item.icon} class="h-4 w-4 inline-flex mx-2 text-blue-500" />} 
             <span>{item.text}</span>
  </a> 

))}  
      </nav>
    </div>

    <div class="inline-flex gap-x-2">
      <ThemeToggle />
      <a href="/rss.xml"
        ><Icon
          name="rss"
          class="h-5 w-5 text-foreground dark:text-green hover:text-mist outline-none"
        /></a
      >
    </div>
  </div>
</header>
