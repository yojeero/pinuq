---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Articles", href: "/blog/all", icon: "note" },
  { text: "About", href: "/about", icon: "about" },
  { text: "Team", href: "/team", icon: "team" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="w-full border-b border-l border-r border-border rounded-md">
  <div
    class="flex flex-wrap font-mono w-full max-w-6xl mx-auto items-center min-h-12 lg:h-12"
  >
    <a
      href="/"
      class="order-1 flex shrink-0 items-center gap-2 px-6 h-12 lg:border-r border-border"
      aria-label={siteConfig.title}
    >
      <Icon
        name="pinuq"
        class="h-8 w-auto text-black dark:text-amber-500 mr-4"
      />
    </a>

    <div
      class="order-3 w-full border-t border-border flex items-center justify-start lg:order-2 lg:w-auto lg:flex-1 lg:border-t-0 h-12 overflow-x-auto scrollbar-none"
    >
      <nav
        aria-label="Primary"
        class="flex h-full items-center  whitespace-nowrap"
      >
        {navItems.map((item) => (
  <a
    href={item.href}
    aria-current={isActive(item.href) ? "page" : undefined}
    class="inline-flex items-center gap-x-3 px-5 text-sm border-r border-border text-slate-400 hover:text-black dark:hover:text-amber-500 h-full uppercase"
  >
    {item.text}
  </a>
))}
      </nav>
    </div>

    <div
      class="order-2 ml-auto flex shrink-0 items-center justify-end gap-2 px-6 h-12 lg:order-3"
    >
      <ThemeToggle />
    </div>
  </div>
</header>
