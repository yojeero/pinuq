---
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";
---

<header class="flex min-h-24 items-center">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between">
    <a class="flex" aria-label={siteConfig.title} href="/">
      <img
        src={siteConfig.logo.src}
        alt={siteConfig.logo.alt}
        class="h-16 w-16 rounded-full bg-amber-300 hover:-rotate-12 transition-transform duration-500 shrink-0"
      >
    </a>

    <p
      class="flex flex-row flex-1 font-mono uppercase text-[0.7rem] tracking-wide items-center gap-2 py-1 ml-6"
    >
      <span
        class="flex items-center w-1.5 h-1.5 rounded-full bg-green-600"
        aria-hidden="true"
      ></span>

      Journal / Notes / Ideas
    </p>

    <ThemeToggle />
  </div>
</header>
