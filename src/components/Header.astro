---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

// const navItems = [
//   { text: "Blog", href: "/blog/all" },
//   { text: "About", href: "/about" },
//   { text: "Team", href: "/team" },
// ];

const navItems = [
  { text: "Blog", href: "/blog/all", icon: "blog" }, 
  { text: "About", href: "/about", icon: "info" },
  { text: "Team", href: "/team", icon: "users" },
  { text: "RSS", href: "/rss.xml", icon: "rss" },
];
---

    <header class="flex w-full bg-gray-100/70 dark:bg-black/5 py-2 px-4">

<div class="flex w-full mx-auto max-w-6xl items-center justify-between">

      <div class="flex items-center gap-4">
        <a
          href="/"
          class="flex items-center gap-3 text-lg font-medium tracking-tight  text-foreground dark:text-green hover:text-mauve dark:hover:text-rose-500 rounded-full bg-blue-500 p-3"
          aria-label={siteConfig.title}
        >
          <Icon
            name="note"
            class="h-4 w-4 items-center text-white hover:text-rose-50" 
          /> 

        </a>
      </div>

      <nav
        class="hidden items-center mx-auto text-xs md:flex gap-4"
  
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
  <a
    href={item.href}
    class="tracking-wider text-foreground hover:text-mauve dark:hover:text-green"
  >

     {item.icon && <Icon name={item.icon} class="h-4 w-4 inline-flex mx-2 text-blue-500" />} 
             <span>{item.text}</span>
  </a> 

))}  
      </nav>

      <ThemeToggle />

</div>

</header>
