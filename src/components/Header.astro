---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import siteConfig from "@/data/site-config";

const navItems = [
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="w-full border-b border-line">
  <div
    class="flex flex-wrap font-mono w-full max-w-6xl mx-auto items-center h-max"
  >
    <a
      href="/"
      class="order-1 flex shrink-0 items-center gap-2 h-16 lg:border-r border-line bg-rose-500 px-6"
      aria-label={siteConfig.title}
    >
      <Icon name="pinuq" class="h-8 w-auto text-white" />
    </a>

    <div
      class="order-3 w-full border-t border-line flex items-center justify-start lg:order-2 lg:w-auto lg:flex-1 lg:border-t-0 h-14 lg:h-16 overflow-x-auto scrollbar-none"
    >
      <nav
        aria-label="Primary"
        class="flex h-full items-center whitespace-nowrap"
      >
        {navItems.map((item) => (
  <a
    href={item.href}
    aria-current={isActive(item.href) ? "page" : undefined}
    class="inline-flex items-center gap-x-3 px-5 text-sm border-r border-line text-slate-400 hover:text-black dark:hover:text-amber-500 h-full"
  >
    {item.text}
  </a>
))}
      </nav>
    </div>

    <div
      class="order-2 ml-auto flex shrink-0 items-center justify-end gap-2 px-6 lg:order-3"
    >
      <ThemeToggle />
    </div>
  </div>
</header>
