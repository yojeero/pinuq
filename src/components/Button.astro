---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"a">, "class"> & {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
};

const { href, variant = "primary", class: className, ...props } = Astro.props;

const baseClasses =
  "inline-flex w-fit border-2 border-black bg-accent px-5 py-3 font-light text-xs text-black shadow-[4px_4px_0_0] shadow-black hover:bg-mauve hover:text-mauve-200 tracking-wider";

const variants = {
  primary: " ",
  secondary: " ",
} as const;
---

<a href={href} class={cn(baseClasses, variants[variant], className)} {...props}>
  <slot />
</a>
