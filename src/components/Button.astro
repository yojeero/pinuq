---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"a">, "class"> & {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
};

const { href, variant = "primary", class: className, ...props } = Astro.props;

const baseClasses =
  "inline-flex h-9 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold whitespace-nowrap transition-all duration-200 hover:bg-slate-400";

const variants = {
  primary: "bg-rose-500 text-white shadow-sm hover:shadow-md",
  secondary:
    "border-[1.5px] border-muted-foreground/40 text-foreground hover:bg-slate-400 hover:text-white",
} as const;
---

<a href={href} class={cn(baseClasses, variants[variant], className)} {...props}>
  <slot />
</a>
