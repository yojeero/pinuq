---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"a">, "class"> & {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
};

const { href, variant = "primary", class: className, ...props } = Astro.props;

const baseClasses =
  "inline-flex border-2 border-black bg-white px-5 py-3 font-light text-black shadow-[4px_4px_0_0] shadow-black hover:translate-1 hover:shadow-none  focus:outline-0 hover:bg-muted-foreground/50 hover:border-foreground dark:bg-rose-500";

const variants = {
  primary: " ",
  secondary:
    " ",
} as const;
---

<a href={href} class={cn(baseClasses, variants[variant], className)} {...props}>
  <slot />
</a>
