---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = Omit<HTMLAttributes<"div">, "class"> & {
  class?: string;
  href?: string;
};

const { href, class: className, ...props } = Astro.props;

const baseClasses =
  "flex w-fit uppercase text-xs font-mono tracking-widest border border-slate-500 px-2 rounded-xs mt-4";

const linkClasses = cn(
  baseClasses,
  "hover:text-slate-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring",
  className,
);
const divClasses = cn(baseClasses, className);
---

{href ? (
  <a href={href} class={linkClasses} {...props}>
    <slot />
  </a>
) : (
  <div class={divClasses} {...props}>
    <slot />
  </div>
)}
