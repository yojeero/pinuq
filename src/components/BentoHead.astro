---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/blog/**/*.{jpeg,jpg,png,webp,avif}",
);

const sortedPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

let latestItem: {
  image: ImageMetadata;
  postTitle: string;
  postUrl: string;
} | null = null;

for (const post of sortedPosts) {
  const folder = post.id.split("/")[0];
  const prefix = `/src/content/blog/${folder}/`;

  const imageKey = Object.keys(allImages).find((path) =>
    path.startsWith(prefix),
  );

  if (imageKey) {
    const imageModule = await allImages[imageKey]();
    latestItem = {
      image: imageModule.default,
      postTitle: post.data.title,
      postUrl: `/blog/${post.id}/`,
    };
    break;
  }
}

if (!latestItem) {
  throw new Error("Does not have images");
}
---

<a
  href={latestItem.postUrl}
  class="grid aspect-4/3 rounded-xl overflow-hidden"
>
  <Image
    src={latestItem.image}
    alt={latestItem.postTitle}
    widths={[400, 640, 820, 1024, 1536, 2048]}
    sizes="(max-width: 1024px) 100vw, 1024px"
    format="webp"
    quality={90}
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    class="w-full h-full object-cover"
  />
</a>
