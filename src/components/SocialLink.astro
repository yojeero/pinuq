---
import Icon from "@/components/Icon.astro";
import { cn } from "@/lib/utils";

const { text, href, icon, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={cn(
  "flex items-center justify-center rounded-full transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
  className,
)}
>
  {icon && <Icon icon={icon} class={cn("h-6 w-6", icon === "fill-current")} />}
  <span class="sr-only">{text} (opens in new tab)</span>
</a>
