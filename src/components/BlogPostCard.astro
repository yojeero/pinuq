---
import { Image } from "astro:assets";
import type { BlogPost } from "@/data/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  post: BlogPost;
  featured?: boolean;
};

const { post, featured = false } = Astro.props;
const { title, excerpt, tags = [], coverImage, coverAlt } = post.data;

const primaryTag = tags[0];

const hasCover = Boolean(coverImage);
---

<article
  class:list={["min-w-0", featured && "blog-card", !hasCover && "blog-card--no-cover"]}
>
  {hasCover && coverImage && (
  <a href={`/blog/${post.id}/`} aria-label={`Read ${title}`}>
    <Image
      src={coverImage}
      alt={coverAlt ?? title}
      widths={[520, 1040]}
      sizes="(max-width: 520px) 100vw, 520px"
      class="w-full max-w-[520px] aspect-video object-cover hover:scale-105 transition-transform mb-4 mx-auto rounded-md grayscale-100 hover:grayscale-0 dark:opacity-30 dark:hover:opacity-100"
    />
  </a>
)}

  <div class="flex flex-col justify-center ml-1">
    <h2
      class="font-medium leading-normal tracking-wide text-xl hover:text-slate-400"
    >
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>

    {excerpt && (
  <p class="font-light text-sm leading-normal tracking-wide text-foreground">
    {excerpt}
  </p>
)}

    <div
      class="flex w-fit uppercase text-xs font-mono tracking-widest border border-slate-500 px-2 rounded-xs mt-4 hover:text-slate-400"
    >
      {primaryTag && <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>}
    </div>
  </div>
</article>
