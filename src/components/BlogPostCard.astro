---
import { Image } from "astro:assets";
import FormattedDate from "@/components/FormattedDate.astro";
import type { BlogPost } from "@/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  post: BlogPost;
  featured?: boolean;
};

const { post, featured = false } = Astro.props;
const {
  title,
  excerpt,
  publishDate,
  tags = [],
  coverImage,
  coverAlt,
  author,
} = post.data;
const primaryTag = tags[0];
---

<article class:list={["blog-card", featured && "blog-card--featured"]}>
  <a
    class="blog-card__media"
    href={`/blog/${post.id}/`}
    aria-label={`Read ${title}`}
  >
    <Image
      src={coverImage}
      alt={coverAlt}
      quality={100}
      widths={featured ? [640, 960, 1280, 1600] : [480, 720, 960]}
      sizes={featured
        ? "(min-width: 1024px) 62vw, 100vw"
        : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"}
      class="h-full w-full object-cover"
      loading={featured ? "eager" : "lazy"}
    />
    <span class="blog-card__arrow" aria-hidden="true">↗</span>
  </a>

  <div class="blog-card__body">
    <div class="blog-card__meta">
      <div>
        {primaryTag && (
          <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>
        )}
      </div>
      <time datetime={publishDate.toISOString()}>
        <FormattedDate date={publishDate} />
      </time>
    </div>

    <h2>
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>

    {excerpt && <p>{excerpt}</p>}

    {author && <span class="blog-card__author">By {author}</span>}
  </div>
</article>
