---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import type { BlogPost } from "@/data/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  post: BlogPost;
  featured?: boolean;
};

const { post, featured = false } = Astro.props;
const { title, excerpt, tags = [], coverImage, coverAlt, publishDate } = post.data;

const primaryTag = tags[0];

const hasCover = Boolean(coverImage);
---

<article
  class:list={["min-w-0", featured && "blog-card", !hasCover && "blog-card--no-cover"]}
>
<div class="bg-card text-foreground ring ring-blue/20 flex flex-col rounded-xl p-4 text-sm group h-full overflow-hidden">
  {hasCover && coverImage && (
  <a href={`/blog/${post.id}/`} aria-label={`Read ${title}`}>
    <Image
      src={coverImage}
      alt={coverAlt ?? title}
      widths={[520, 1040]}
      sizes="(max-width: 520px) 100vw, 520px"
      class="w-full max-w-[520px] aspect-[4/3] object-cover hover:scale-105 transition-transform mb-4 mx-auto rounded-xl dark:opacity-30 dark:hover:opacity-100"
    />
  </a>
)}

  <div class="flex flex-col justify-start space-y-3">

    <div
      class="flex w-fit text-[10.5px] tracking-widest bg-blue/5 text-mauve/80 px-2 py-1 rounded-full hover:text-slate-400"
    >
      {primaryTag && <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>}
    </div>

    <h2
      class="font-medium leading-normal tracking-wide text-xl hover:text-black"
    >
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>

    {excerpt && (
  <p class="text-sm leading-normal tracking-wide text-foreground line-clamp-3">
    {excerpt}
  </p>
)}

    <div class="w-full flex text-mist items-center justify-between gap-2 mt-2">
      <div class="text-[10.5px] tracking-wide text-blue">
          <Icon name="calendar" class="inline-flex h-5 w-5 mr-2 items-center" />
        <FormattedDate date={publishDate} format="short" />
      </div>

      <a href={`/blog/${post.id}/`}>
        <Icon name="arrow-up" class="h-8 w-8 text-mist hover:text-rose p-1 border border-line rounded-lg cursor-pointer" />
        </a>

    </div>

  </div>
  </div>
</article>
