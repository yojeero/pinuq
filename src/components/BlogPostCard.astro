---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import type { BlogPost } from "@/data/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  post: BlogPost;
  featured?: boolean;
  class?: string;
};

const { post, featured = false, class: className } = Astro.props;
const { title, excerpt, tags = [], publishDate } = post.data;

const primaryTag = tags[0];
---

<article class:list={["min-w-0", featured && "blog-card", className]}>
  <div
    class="bg-card text-foreground border border-white hover:border-mauve/60 flex flex-col rounded-2xl p-5 text-sm group h-full overflow-hidden transition-colors"
  >
    <div class="flex flex-col justify-start space-y-3">
      <div
        class="flex w-fit text-[10.5px] tracking-widest bg-blue/5 text-mauve/80 px-2 py-1 rounded-full hover:text-slate-400"
      >
        {primaryTag && <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>}
      </div>

      <h2
        class="font-medium leading-normal tracking-wide text-xl hover:text-black"
      >
        <a href={`/blog/${post.id}/`}>{title}</a>
      </h2>

      {excerpt && (
  <p class="text-sm leading-normal tracking-wide text-foreground line-clamp-3">
    {excerpt}
  </p>
)}

      <div
        class="w-full flex text-mist items-center justify-between gap-2 mt-2"
      >
        <div class="text-[10.5px] tracking-wide text-blue">
          <Icon name="calendar" class="inline-flex h-5 w-5 mr-2 items-center" />
          <FormattedDate date={publishDate} format="short" />
        </div>

        <a href={`/blog/${post.id}/`}>
          <Icon
            name="arrow-up"
            class="h-8 w-8 text-mist hover:text-rose p-1 border white rounded-lg cursor-pointer"
          />
        </a>
      </div>
    </div>
  </div>
</article>
