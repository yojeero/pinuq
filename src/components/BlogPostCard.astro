---
import { Image } from "astro:assets";
import FormattedDate from "@/components/FormattedDate.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  post: BlogPost;
  featured?: boolean;
};

const { post, featured = false } = Astro.props;
const {
  title,
  excerpt,
  publishDate,
  tags = [],
  coverImage,
  coverAlt,
  author,
} = post.data;

const authorName = author || siteConfig.author;

const primaryTag = tags[0];

const hasCover = Boolean(coverImage);
---

<article
  class:list={[
  "blog-card",
  featured && "blog-card--featured",
  !hasCover && "blog-card--no-cover",
]}
>
  {hasCover && coverImage && (
  <a
    class="blog-card__media"
    href={`/blog/${post.id}/`}
    aria-label={`Read ${title}`}
  >
    <Image
      src={coverImage}
      alt={coverAlt ?? title}
      quality={100}
      widths={featured ? [640, 960, 1280, 1600] : undefined}
      sizes={
        featured
          ? "(min-width: 1024px) 62vw, 100vw"
          : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      }
      class="h-full w-full object-cover"
      loading={featured ? "eager" : "lazy"}
    />
  </a>
)}

  <div class="blog-card__body">
    <div class="blog-card__meta">
      <div class="flex items-center gap-2 text-stone-700">
        {authorName && <span class="text-stone-500 mx-1 p-1">By {authorName}</span>}

        <time datetime={publishDate.toISOString()}>
          <FormattedDate date={publishDate} />
        </time>
      </div>
      <div
        class="w-fit lowercase mt-6 text-xs font-sans bg-stone-50 py-2 px-4 tracking-widest rounded-md dark:bg-indigo-900/60 dark:text-stone-300"
      >
        {primaryTag && <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>}
      </div>
    </div>

    <h2>
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>

    {excerpt && <p>{excerpt}</p>}
  </div>
</article>
