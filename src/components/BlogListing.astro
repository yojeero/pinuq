---
import { Image } from "astro:assets";
import BlogNotesList from "@/components/BlogNotesList.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Button from "@/components/Button.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  posts: BlogPost[];
  categories: string[];
  currentPage: number;
};

const { posts, currentPage } = Astro.props;
const notePosts = posts.filter((post) => !post.data.coverImage);
const cardPosts = posts.filter((post) => post.data.coverImage);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,webp}",
);
---

<BaseLayout
  title={currentPage > 1 ? `Blog ${siteConfig.titleSeparator} Page ${currentPage}` : ""}
  description="Explore tech news & lifestyle."
  mainClass="blog-main"
>
  <div class="blog-main-slot">
    {currentPage === 1 && (
  <section
    aria-labelledby="heading"
    class="grid grid-cols-1 md:grid-cols-[2fr_1fr] mb-12 px-2"
  >  
  
  <div class="w-full grid items-center gap-4">
    <h1
      id="featured-heading"
      class="text-4xl md:text-5xl lg:text-7xl font-bold max-w-3xl text-foreground tracking-wide"
    >
      Tech & Lifestyle news.
    </h1>
  
      <h3 class="text-lg md:text-2xl lg:text-3xl lg:leading-10">
        PINUQ captures the bold aesthetics born when smart technology merges
        with unapologetic street style.
      </h3>

      <Button href="/blog/all/">All posts &rarr;</Button>
      </div>

      <div class="md:block hidden h-80 mx-auto lg:w-auto aspect-[4/5] shadow-[4px_4px_0_0,8px_8px_0_0] shadow-black overflow-hidden">

        <Image
          src={images["/src/assets/images/notes.webp"]()}
          alt="header image"
          widths={[400, 900, 1280]}
          sizes="(max-width: 768px) 100vw, 768px"
          class="h-80 object-cover object-center"
        />

      </div>

  </section>
)}

    {cardPosts.length > 0 && (
  <section aria-labelledby="latest-heading" class="blog-grid">
    {cardPosts.map((post) => (
      <BlogPostCard post={post} />
    ))}
  </section>
)}
  </div>

  <slot />

  <section class="notes-bg" aria-labelledby="notes">
    {notePosts.length > 0 && (
  <div class="notes-center">
    <BlogNotesList posts={notePosts} />
  </div>
)}
  </section>
</BaseLayout>
