---
import { Image } from "astro:assets";
import BlogNotesList from "@/components/BlogNotesList.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Button from "@/components/Button.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  posts: BlogPost[];
  categories: string[];
  currentPage: number;
};

const { posts, currentPage } = Astro.props;
const notePosts = posts.filter((post) => !post.data.coverImage);
const cardPosts = posts.filter((post) => post.data.coverImage);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,webp}",
);
---

<BaseLayout
  title={currentPage > 1 ? `Blog ${siteConfig.titleSeparator} Page ${currentPage}` : ""}
  description="Explore tech news & lifestyle."
  mainClass="blog-main"
>
  <div class="blog-main-slot">
    {currentPage === 1 && (
  <section class="py-[clamp(2rem,4vw,6rem)]" aria-labelledby="heading">
    <div class="flex flex-col items-start gap-6">
      <h1
        id="featured-heading"
        class="text-4xl md:text-5xl lg:text-8xl font-bold max-w-3xl text-foreground tracking-wide my-4"
      >
        Tech & Lifestyle news.
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 max-w-5xl items-center gap-8">
        <h3 class="text-lg md:text-2xl lg:text-4xl lg:leading-12">
          PINUQ captures the bold aesthetics born when smart technology merges
          with unapologetic street style.
        </h3>
        <div class="h-96 aspect-[4/5]">
          <Image
            src={images["/src/assets/images/notes.webp"]()}
            alt="header image"
            widths={[400, 900, 1280]}
            sizes="(max-width: 768px) 100vw, 768px"
            class="h-96 object-cover object-center rounded-4xl"
          />
        </div>
      </div>

      <Button href="/blog/all/">All posts &rarr;</Button>
    </div>
  </section>
)}

    {cardPosts.length > 0 && (
  <section aria-labelledby="latest-heading">
    <div class="blog-grid">
      {cardPosts.map((post) => (
        <BlogPostCard post={post} />
      ))}
    </div>
  </section>
)}
  </div>

  <slot />

  <div class="notes-bg">
    {notePosts.length > 0 && (
  <section class="notes-center" aria-labelledby="notes">
    <BlogNotesList posts={notePosts} />
  </section>
)}
  </div>
</BaseLayout>
