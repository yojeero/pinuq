---
import FormattedDate from "@/components/FormattedDate.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  posts: BlogPost[];
  categories: string[];
  currentPage: number;
};

const { posts, currentPage } = Astro.props;
---

<BaseLayout
  title={currentPage > 1 ? `${siteConfig.titleSeparator} Page ${currentPage}` : ""}
  description="Explore tech news & lifestyle."
  mainClass="blog-main"
>
  <div class="mx-auto max-w-4xl w-full py-[clamp(4rem,6vw,8rem)] px-4 sm:px-6">
    <header class="mb-12 md:mb-16">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-foreground"
      >
        Blog
      </h2>
    </header>

    <ul class="divide-y divide-line">
      {posts.map((post) => (
  <li class="group">
    <a
      href={`/blog/${post.id}/`}
      class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 py-5 sm:py-6"
    >
      <h2 class="text-lg sm:text-xl font-medium tracking-wide dark:text-mist">
        {post.data.title}
      </h2>
      <time class="text-sm text-mist whitespace-nowrap shrink-0">
        <FormattedDate date={post.data.publishDate} format="short" />
      </time>
    </a>
  </li>
))}
    </ul>
  </div>

  <slot />
</BaseLayout>
