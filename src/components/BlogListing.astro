---
// import { Image } from "astro:assets";
import BlogNotesList from "@/components/BlogNotesList.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Button from "@/components/Button.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  posts: BlogPost[];
  categories: string[];
  currentPage: number;
};

const { posts, currentPage } = Astro.props;
const notePosts = posts.filter((post) => !post.data.coverImage);
const cardPosts = posts.filter((post) => post.data.coverImage);

// const images = import.meta.glob<{ default: ImageMetadata }>(
//   "/src/assets/**/*.{jpeg,jpg,png,webp}",
// );
---

<BaseLayout
  title={currentPage > 1 ? `Blog ${siteConfig.titleSeparator} Page ${currentPage}` : ""}
  description="Explore tech news & lifestyle."
  mainClass="blog-main"
>
  <div class="mx-auto grid max-w-6xl w-full py-[clamp(4rem,4vw,6rem)]">
    {currentPage === 1 && (
  <section
    aria-labelledby="heading"
    class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] mb-32 px-2"
  >
    <div class="w-full grid items-center gap-4 tracking-wide font-bold">
      <h1
        id="featured-heading"
        class="text-4xl md:text-5xl lg:text-7xl text-foreground"
      >
        Tech & lifestyle journal
      </h1>

      <h3 class="text-2xl text-foreground mb-4">/ our captures</h3>

      <Button href="/blog/all/">All writing &rarr;</Button>
    </div>

    <div class="flex h-full place-content-center mt-12">

      <div class="px-6 py-12 flex flex-col gap-4 items-center justify-center w-full border border-line">  
        <div class="text-center">
          <div class="text-xs tracking-normal text-mauve-700 uppercase mb-2">— Master Class —</div>
          <div class="font-[Georgia] text-3xl text-mauve-800 leading-none mb-2 tracking-wide">Letterpress &amp; Bindery</div>
          <div class="text-[0.65rem] tracking-wider text-amber-700/60 uppercase">N° 0247 · Awarded May 2026</div>
        </div>
      </div>

      </div>
          
        </section>
      )}

    {cardPosts.length > 0 && (
  <section aria-labelledby="latest-heading" class="blog-grid">
    {cardPosts.map((post) => (
      <BlogPostCard post={post} />
    ))}
  </section>
)}
  </div>

  <slot />

  <section class="notes-bg" aria-labelledby="notes">
    {notePosts.length > 0 && (
  <div class="notes-center">
    <BlogNotesList posts={notePosts} />
  </div>
)}
  </section>
</BaseLayout>
