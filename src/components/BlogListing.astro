---
import BlogNotesList from "@/components/BlogNotesList.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import siteConfig from "@/data/site-config";
import type { BlogPost } from "@/data/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  posts: BlogPost[];
  categories: string[];
  currentPage: number;
};

const { posts, currentPage } = Astro.props;
// Featured post on the main page always with a cover
const featuredPost =
  currentPage === 1
    ? (posts.find((post) => post.data.coverImage) ?? null)
    : null;
const gridPosts = featuredPost
  ? posts.filter((post) => post.id !== featuredPost.id)
  : posts;
// Posts without covers are displayed not as cards, but as a compact list
const notePosts = gridPosts.filter((post) => !post.data.coverImage);
const cardPosts = gridPosts.filter((post) => post.data.coverImage);
---

<BaseLayout
  title={currentPage > 1 ? `Blog ${siteConfig.titleSeparator} Page ${currentPage}` : ""}
  description="Explore tech tips, coding journeys, and advice for developers and tech enthusiasts."
  mainClass="blog-main"
>
  <div class="blog-main-slot">
    {featuredPost && (
  <section class="blog-section" aria-labelledby="featured-heading">
    <BlogPostCard post={featuredPost} featured />
  </section>
)}

    {cardPosts.length > 0 && (
  <section class="blog-section" aria-labelledby="latest-heading">
    <div class="blog-grid">
      {cardPosts.map((post) => (
        <BlogPostCard post={post} />
      ))}
    </div>
  </section>
)}
  </div>

  <div class="notes-bg">
    {notePosts.length > 0 && (
  <section class="notes-center" aria-labelledby="notes-heading">
    <div class="blog-section-heading">
      <p id="notes-heading">Notes</p>
    </div>

    <BlogNotesList posts={notePosts} />
  </section>
)}
  </div>

  <slot />
</BaseLayout>
