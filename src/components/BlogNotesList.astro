---
import type { BlogPost } from "@/data/types";
import { slugify } from "@/utils/common-utils";

type Props = {
  posts: BlogPost[];
};

const { posts } = Astro.props;
const notePosts = posts.slice(0, 9);
---

<ol
  class="grid list-none w-full grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6"
>
  {notePosts.map((post) => {
  const { title, excerpt, publishDate, tags = [] } = post.data;
  const primaryTag = tags[0];

  return (
    <li class="flex min-w-0 flex-col pt-2">
      <div class="flex items-center gap-3 mb-2 text-xs uppercase font-mono tracking-tight">
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString("us-US", {
            day: "numeric",
            month: "numeric",
            year: "numeric",
          })}
        </time>
        {primaryTag && (
          <a href={`/tags/${slugify(primaryTag)}/`}>{primaryTag}</a>
        )}
      </div>

      <h3 class="font-medium leading-normal tracking-wide text-lg hover:text-foreground">
        <a href={`/blog/${post.id}/`}>{title}</a>
      </h3>

      {excerpt && (
        <p class="mt-2 mx-0 mb-0 text-xs leading-normal font-mono tracking-tight">
          {excerpt}
        </p>
      )}
    </li>
  );
})}
</ol>

<div class="mt-[clamp(2.5rem,_5vw,_4rem)]">
  <a
    href="/blog/all"
    class="inline-flex items-center text-xs tracking-wide uppercase hover:text-mauve"
    >More Notes</a
  >
</div>
