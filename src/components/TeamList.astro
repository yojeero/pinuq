---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section
  class="not-prose mx-auto max-w-4xl flex flex-col gap-8 py-[clamp(4rem,6vw,8rem)]"
>
  <div class="flex flex-col p-4 lg:p-18 justify-center">
    <h2
      class="w-full font-medium text-4xl md:text-5xl lg:text-6xl font-medium tracking-wide dark:text-mist"
    >
      Team.
    </h2>
    <p class="text-xl max-w-3xl pt-2">
      Professionals building the digital future every day.
    </p>
  </div>

  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 bg-white/40 dark:bg-blue/20"
  >
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  return (
    <div class="flex flex-col">
      {avatar && (
        <Image
          src={avatar}
          alt={`Photo of ${member.name}`}
          class="w-full aspect-square object-cover object-center overflow-hidden"
        />
      )}

      <div class="tracking-wide px-8 py-12 lg:px-18 flex flex-col justify-center text-lg">
        <p class="leading-8 text-sm font-mono text-mist">{member.name}</p>
        <p class="leading-5 text-base text-foreground/80">{member.role}</p>
      </div>
    </div>
  );
})}
  </div>
</section>
