---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section
  class="not-prose mx-auto max-w-5xl bg-stone flex flex-col gap-8 bg-white/20"
>
  <div class="grid justify-start p-18 gap-4">
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-wide">
      Team.
    </h2>
    <p class="text-xl max-w-3xl">
      Professionals building the digital future every day.
    </p>
  </div>

  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 bg-accent"
  >
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  return (
    <div class="flex flex-col">
      {avatar && (
        <Image
          src={avatar}
          alt={`Photo of ${member.name}`}
          class="w-full aspect-[4/6] object-cover object-top overflow-hidden"
        />
      )}

      <div class="tracking-wide p-18 h-48 overflow-hidden p-8 font-bold text-lg mx-auto border-r border-line w-full">
        <p class="text-white/70 leading-8">{member.name}</p>
        <p class="text-white">{member.role}</p>
      </div>

    </div>
  );
})}
  </div>
</section>
