---
import Icon from "@/components/Icon.astro";
import siteConfig from "@/data/site-config";

const { team } = siteConfig;
---

<div class="space-y-8">
  {team.map((member) => (
    <div class="flex items-center gap-4 p-4 border rounded-lg">
      <img src={member.avatar.src} alt={member.name} class="w-16 h-16 rounded-full" />
      
      <div>
        <h3 class="font-bold text-lg">{member.name}</h3>
        <p class="text-sm text-zinc-500">{member.role}</p>
        <p class="text-sm my-1">{member.bio}</p>

        <div class="flex gap-3 mt-2">
          {member.socials.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              title={social.text}
              class="text-zinc-500 hover:text-black transition-colors"
            >
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>
