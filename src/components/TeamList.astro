---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section class="not-prose mx-auto max-w-5xl flex flex-col gap-8">
  <div class="flex flex-col p-4 lg:p-18 justify-center mt-8">
    <h2 class="w-full text-4xl md:text-5xl lg:text-6xl font-bold tracking-wide text-foreground dark:text-mist">
      Team.
    </h2>
    <p class="text-xl max-w-3xl pt-2">
      Professionals building the digital future every day.
    </p>
  </div>

  <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  return (
    <div class="flex flex-col">
      {avatar && (
        <Image
          src={avatar}
          alt={`Photo of ${member.name}`}
          class="w-full aspect-[4/5] object-cover object-top overflow-hidden"
        />
      )}

      <div class="tracking-wide p-8 lg:p-18 flex flex-col justify-center text-lg text-foreground dark:text-mist bg-mauve/10">
        <p class="leading-8 text-base">{member.name}</p>
        <p>{member.role}</p>
      </div>
    </div>
  );
})}
  </div>
</section>
