---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section
  class="not-prose mx-auto max-w-6xl bg-stone flex flex-col gap-8 border-x border-border"
>
  <div
    class="border-b border-border grid justify-center text-center py-18 px-4 gap-4"
  >
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-wide">
      Our Team
    </h2>
    <p class="text-xl max-w-3xl">
      Professionals building the digital future every day.
    </p>
  </div>

  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 items-stretch gap-8 py-18"
  >
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  return (
    <div class="w-full flex flex-col items-center border-r last:border-0 border-border h-full">
      {avatar && (
        <Image
          src={avatar}
          alt={`Photo of ${member.name}`}
          class="h-32 w-32 rounded-full object-cover object-top mx-4"
        />
      )}

      <p class="text-2xl font-bold text-foreground mt-4 leading-10 px-4">
        {member.name}
      </p>
      <p class="pb-2 text-base font-medium text-accent mt-auto mb-4 px-4">
        {member.role}
      </p>
    </div>
  );
})}
  </div>
</section>
