---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section
  class="not-prose mx-auto max-w-6xl bg-stone flex flex-col gap-8 border-x border-line"
>
  <div
    class="border-b border-line grid justify-start p-18 gap-4"
  >
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-wide">
      Team.
    </h2>
    <p class="text-xl max-w-3xl">
      Professionals building the digital future every day.
    </p>
  </div>

  <div
    class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
  >
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  return (
    <div class="flex flex-col justify-evenly p-18 bg-white border-b border-line md:border-b-0 md:border-r last:lg:border-0">
      {avatar && (
        <Image
          src={avatar}
          alt={`Photo of ${member.name}`}
          class="h-24 w-24 rounded-full object-cover object-top mb-4"
        />
      )}

      <p class="text-lg text-foreground leading-10">
        {member.name}
      </p>
      <p class="text-sm font-bold">
        {member.role}
      </p>
    </div>
  );
})}
  </div>
</section>
