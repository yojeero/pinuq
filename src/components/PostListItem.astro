---
import { Image } from "astro:assets";
import Badge from "@/components/Badge.astro";
import type { PostListItemProps } from "@/data/types";
import { slugify } from "@/utils/common-utils";

const {
  post,
  class: className,
  hideTags = false,
  showCover = false,
} = Astro.props as PostListItemProps;
const { title, publishDate, tags = [], coverImage, coverAlt } = post.data;
---

<li class:list={[className]}>
  {showCover && coverImage && (
  <a href={`/blog/${post.id}/`} aria-label={`Read ${title}`} class="shrink-0">
    <Image
      src={coverImage}
      alt={coverAlt ?? title}
      width={520}
      height={293}
      widths={[520, 1040]}
      sizes="(max-width: 520px) 100vw, 520px"
      class="w-full max-w-[520px] aspect-video object-cover rounded-lg"
    />
  </a>
)}
  <div class="flex flex-col gap-1">
    <span class="font-medium"><a href={`/blog/${post.id}/`}>{title}</a></span>
    <div class="flex items-center gap-x-5 gap-y-2">
      <span class="text-foreground/60 text-sm">
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString("de-DE", {
  day: "numeric",
  month: "short",
  year: "numeric",
})}
        </time>
      </span>
      {!hideTags && (
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    {tags.length > 0 &&
      tags.map((tag) => <Badge href={`/tags/${slugify(tag)}/`}>{tag}</Badge>)}
  </div>
)}
    </div>
  </div>
</li>
