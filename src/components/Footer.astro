---
import siteConfig from "@/data/site-config";

const currentYear = new Date().getFullYear();
---

<footer
  id="foot"
  class="w-full overflow-hidden max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 py-20 items-center"
>
  <div
    class="flex flex-col md:flex-row place-content-center items-center lg:justify-start gap-4 my-8"
  >
    <a href="/" target="_blank">
      <img
        alt="logo-footer"
        class="h-32 w-auto bg-amber-300 p-2 rounded-full"
        src="/images/logo_2.png"
      >
    </a>
    <a href="https://t.me/" target="_blank">
      <span class="text-lg tracking-widest hover:text-blue-300">Telegram</span>
    </a>
  </div>

  <div class="flex text-sm justify-center lg:justify-end">
    <a
      class="flex hover:text-blue-300"
      aria-label={siteConfig.title}
      href="https//pinux.vercel.app/"
    >
      © Pinux {currentYear}
    </a>
  </div>
</footer>
