---
const currentYear = new Date().getFullYear();

const navItems = [
  { text: "Home", href: "/" },
  { text: "Blog", href: "/blog/all" },
  { text: "About", href: "/about" },
  { text: "Team", href: "/team" },
];
---

<footer
  id="foot"
  class="w-full min-h-vh flex-1 border-t border-blue py-[clamp(4rem,6vw,8rem)]"
>
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8"
  >
    <nav class="items-center text-sm gap-2 flex" aria-label="Main navigation">
      {navItems.map((item) => (
    <a href={item.href} class="text-foreground hover:text-mist tracking-wide">
      {item.text}
    </a>
    <span class="text-slate-400 last:hidden">•</span>
))}
    </nav>

    <div class="text-sm tracking-wide">© Pinuq {currentYear}</div>
  </div>
</footer>
