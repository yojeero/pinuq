---
import siteConfig from "@/data/site-config";

const currentYear = new Date().getFullYear();
---

<footer id="foot" class="w-full lg:border-t border-mauve py-32">
  <div
    class="w-full max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 lg:items-center place-content-evenly tracking-widest gap-8"
  >
    <div
      class="flex flex-col md:flex-row place-content-center items-center lg:justify-start gap-2"
    >
      <a href="/" aria-label="up" class="font-bold text-blue">
        {siteConfig.title}
      </a>

      <a href="https://t.me/" target="_blank">
        <span class="text-md font-mono text-mist hover:text-foreground px-2"
          >[ Telegram ]</span
        >
      </a>
    </div>

    <div class="flex text-sm justify-center lg:justify-end">
      <a
        class="flex text-foreground hover:text-blue"
        aria-label={siteConfig.title}
        href="https//pinuq.vercel.app/"
      >
        © Pinuq {currentYear}
      </a>
    </div>
  </div>
</footer>
