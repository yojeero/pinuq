---
import { Image } from "astro:assets";
import { team } from "@/data/site-config";
import { resolveAvatar } from "@/utils/team-utils";
---

<section id="team">
  <p class="text-xs uppercase">our</p>

  <h2 class="font-display text-5xl leading-tight pb-8">Team</h2>

  <div class="grid grid-cols-3 gap-3">
    {team.map((member) => {
  const avatar = resolveAvatar(member.avatar);
  if (!avatar) return null;
  return (
    <div class="group text-left tracking-wider">
      <Image
        src={avatar}
        alt={member.name}
        class="w-48 aspect-square object-cover bg-white dark:bg-taupe-800"
        loading="lazy"
        decoding="async"
      />

      <p class="font-display text-lg mt-3">{member.name}</p>
      <p class="text-lg leading-4 py-1 text-taupe-600">{member.role}</p>
    </div>
  );
})}
  </div>
</section>
